# Configuration reference only: Django reads environment variables, not this file.
# Export the values in your shell or configure them in your hosting service.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set your own strong secret for deployment.
DJANGO_SECRET_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required for chick counting. Obtain a new key from your Roboflow workspace.
ROBOFLOW_API_KEY=
ROBOFLOW_WORKFLOW_URL=https://serverless.roboflow.com/fam-world/workflows/detect-count-and-visualize
ROBOFLOW_TIMEOUT_SECONDS=20
PRICE_FORECAST_CONF_THRESHOLD=0.70
